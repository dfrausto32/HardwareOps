# Global-plane runtime configuration
# Copy to global-plane.env and fill in values.

# ── Database ────────────────────────────────────────────────────────────────────
GLOBAL_DATABASE_URL=postgres://parcel:parcel@localhost:5432/parcel_global?sslmode=disable

# ── HTTP ────────────────────────────────────────────────────────────────────────
GLOBAL_HTTP_ADDR=:8090

# ── Auth (shared JWT secret with regional control planes) ───────────────────────
AUTH_JWT_SECRET=change-me-32-char-secret

# ── Token encryption (32-byte AES key, base64-encoded) ──────────────────────────
# Generate: openssl rand -base64 32
GLOBAL_TOKEN_ENCRYPTION_KEY=

# ── Sync ────────────────────────────────────────────────────────────────────────
GLOBAL_SYNC_DEFAULT_INTERVAL=60   # seconds between regional plane polls

# ── MinIO (artifact federation storage) ─────────────────────────────────────────
GLOBAL_MINIO_ENDPOINT=minio:9000
GLOBAL_MINIO_ACCESS_KEY=minioadmin
GLOBAL_MINIO_SECRET_KEY=minioadmin
GLOBAL_MINIO_BUCKET=global-artifacts
GLOBAL_MINIO_USE_TLS=0

# Externally-reachable base URL of this global-plane, sent to regional planes
# as the presign base URL when pushing federation metadata.
GLOBAL_PUBLIC_BASE_URL=https://global-plane.example.com

GLOBAL_PRESIGN_EXPIRES_SECONDS=3600

# ── TLS (optional) ──────────────────────────────────────────────────────────────
ENABLE_TLS=0
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── CORS ────────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Migrations ──────────────────────────────────────────────────────────────────
GLOBAL_MIGRATIONS_DIR=migrations/global
