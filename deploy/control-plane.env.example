# Control-plane runtime configuration
HTTP_ADDR=:8080
DATABASE_URL=postgres://hardwareops:hardwareops@localhost:5432/hardwareops?sslmode=disable

# Certificate authority for device enrollment (required to sign device certs)
CA_CERT_PATH=/opt/hardwareops/certs/ca.crt
CA_KEY_PATH=/opt/hardwareops/certs/ca.key
# Optional CA rotation support
# CA_BUNDLE_PATH=/opt/hardwareops/certs/ca-bundle.crt
# ACTIVE_CA_CERT_PATH=/opt/hardwareops/certs/ca-active.crt
# ACTIVE_CA_KEY_PATH=/opt/hardwareops/certs/ca-active.key
# CERT_ROTATION_GRACE_PERIOD=168h

# Enable TLS directly on the control-plane (optional if using a gateway)
#TLS_CERT_PATH=/opt/hardwareops/certs/server.crt
#TLS_KEY_PATH=/opt/hardwareops/certs/server.key
#TLS_CLIENT_CA_PATH=/opt/hardwareops/certs/ca.crt

# Object store (MinIO/S3)
S3_ENDPOINT=localhost:9000
S3_BUCKET=artifacts
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_USE_SSL=0
S3_REGION=us-east-1
S3_PRESIGN_TTL=5m

# Migrations
AUTO_MIGRATE=1
MIGRATIONS_DIR=./migrations

# Proxy + TLS client cert forwarding
TRUST_PROXY=0
# When TRUST_PROXY=1, replace with the exact reverse-proxy or gateway CIDRs.
TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
CLIENT_CERT_HEADER=X-Client-Cert
DISABLE_HTTP2=1

# CORS (UI origin)
CORS_ALLOWED_ORIGINS=https://hardwareops.internal

# Metrics + health
METRICS_ENABLED=1
METRICS_PATH=/metrics
METRICS_REFRESH_INTERVAL=30s

# Logging
LOG_DIR=./logs
LOG_LEVEL=info

# Audit retention
AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_CLEANUP_INTERVAL=1h
# Runtime event retention
EVENT_RETENTION_DAYS=30
EVENT_RETENTION_CLEANUP_INTERVAL=1h

# Artifact lifecycle (automatic prune + alerts)
ARTIFACT_PRUNE_ENABLED=1
ARTIFACT_PRUNE_INTERVAL=24h
ARTIFACT_PRUNE_BATCH_LIMIT=200
ARTIFACT_PRUNE_ALERT_REF_THRESHOLD=10
# Pull ingest safety controls
# Comma-separated host allowlist for server-side artifact pull (empty = any host)
ARTIFACT_PULL_ALLOWED_HOSTS=
# Max size for pulled artifact in bytes (default 1 GiB)
ARTIFACT_PULL_MAX_BYTES=1073741824
# Timeout for source download
ARTIFACT_PULL_TIMEOUT=15m
# Allow plain HTTP pull sources (set to 0 for production hardening)
ARTIFACT_PULL_ALLOW_INSECURE_HTTP=0
# Signature policy defaults pushed to agents via applyPolicy
ARTIFACT_SIGNATURE_REQUIRE_DEFAULT=0
ARTIFACT_SIGNATURE_ENFORCE_INGEST=0
ARTIFACT_SIGNATURE_KEY_ID=
# Optional static credential map for pull adapters
# File takes precedence over JSON when both are set.
# ARTIFACT_PULL_CREDENTIALS_FILE=/opt/hardwareops/pull-credentials.json
ARTIFACT_PULL_CREDENTIALS_FILE=
ARTIFACT_PULL_CREDENTIALS_JSON=
# Optional AWS Secrets Manager secret containing the same JSON map structure.
ARTIFACT_PULL_CREDENTIALS_AWS_SECRET_ID=
ARTIFACT_PULL_CREDENTIALS_AWS_REGION=
RELEASE_AUTO_UPDATE_INTERVAL=60s

# Auth (local users)
AUTH_MODE=disabled
# AUTH_MODE=local
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL=12h
AUTH_LOGIN_RPM=30
AUTH_LOGIN_BACKOFF_ENABLED=1
AUTH_LOGIN_BACKOFF_THRESHOLD=3
AUTH_LOGIN_BACKOFF_BASE=2s
AUTH_LOGIN_BACKOFF_MAX=5m
AUTH_LOGIN_BACKOFF_WINDOW=15m
AUTH_ISSUER=hardwareops
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me
# Pending enrollment abuse controls (first-contact onboarding)
PENDING_ENROLL_REQUEST_RPM_PER_SOURCE=30
PENDING_ENROLL_REQUEST_RPM_PER_PROFILE=120
PENDING_ENROLL_MAX_ACTIVE=1000
PENDING_ENROLL_MAX_ACTIVE_PER_PROFILE=100
PENDING_ENROLL_MAX_ACTIVE_PER_SOURCE=10
# OIDC placeholders (future)
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
# Optional bootstrap token for unauthenticated CA download
BOOTSTRAP_TOKEN=

# Maintenance + upgrade
MAINTENANCE_MODE=1
MAINTENANCE_MESSAGE=Maintenance mode enabled
# Optional token for non-UI automation (for example apply-upgrade.sh auto-disable)
MAINTENANCE_TOKEN=change-me
UPGRADE_APPLY_CMD=
UPGRADE_WORK_DIR=
UPGRADE_LOG_DIR=
UPGRADE_UPDATES_DIR=
UPGRADE_RUNNER_MODE=disabled
UPGRADE_RUNNER_URL=
UPGRADE_RUNNER_TOKEN=
UPGRADE_RUNNER_IMAGE=

# Backup + restore
BACKUP_CMD=
RESTORE_CMD=
BACKUP_DIR=/stack/backups
BACKUP_WORK_DIR=/stack
BACKUP_LOG_DIR=/var/lib/hardwareops/logs
BACKUP_RUNNER_MODE=disabled
BACKUP_RUNNER_URL=
BACKUP_RUNNER_TOKEN=
BACKUP_RUNNER_IMAGE=
BACKUP_POSTGRES_CONTAINER=
BACKUP_MINIO_CONTAINER=
BACKUP_POSTGRES_USER=hardwareops
BACKUP_POSTGRES_DB=hardwareops

# License enforcement
LICENSE_ENFORCE=0
LICENSE_PATH=
LICENSE_PUBLIC_KEY=
LICENSE_PUBLIC_KEY_PATH=
LICENSE_KEY_MODE=env
LICENSE_CACHE_TTL=30s
HARDENED_PROFILE=0

# Device identity hardening (anti-clone / duplicate enrollment)
# disabled | audit | enforce
DEVICE_IDENTITY_MODE=audit
# Require hardware identity during /devices/enroll when mode=enforce.
DEVICE_IDENTITY_REQUIRE_ON_ENROLL=0
# Require hardware identity on every check-in when mode=enforce.
DEVICE_IDENTITY_REQUIRE_ON_CHECKIN=0
