CONTROL_PLANE_URL=https://agent.hardwareops.internal
STATE_PATH=/var/lib/hardwareops/agent/state.json
ARTIFACT_ROOT=/var/lib/hardwareops/agent/artifacts
DEVICE_CERT_PATH=/etc/hardwareops/agent/certs/device.crt
DEVICE_KEY_PATH=/etc/hardwareops/agent/certs/device.key
DEVICE_ID_PATH=/var/lib/hardwareops/agent/device-id
BOOTSTRAP_STATE_PATH=/var/lib/hardwareops/agent/bootstrap-state.json
CONTROL_PLANE_CA_CERT_PATH=/etc/hardwareops/agent/certs/ca.crt
CHECKIN_INTERVAL=30s
LOG_LEVEL=info
AUTO_REENROLL=1

# Remove CONTROL_PLANE_CA_CERT_PATH when the control-plane server certificate is
# signed by a public CA and the host system trust store should be used instead.

# First-contact approval onboarding:
# AGENT_ENROLL_MODE=approval
# ENROLLMENT_PROFILE_TOKEN=ep_tok_replace_me
# BOOTSTRAP_POLL_INTERVAL=5s
# BOOTSTRAP_RETRY_INTERVAL=10s
