DOMAIN=hardwareops.internal
PUBLIC_BASE_URL=https://hardwareops.internal
CERTS_DIR=/opt/hardwareops/certs
STACK_DIR=/opt/hardwareops/stack

POSTGRES_USER=hardwareops
POSTGRES_PASSWORD=hardwareops
POSTGRES_DB=hardwareops
DATABASE_URL=postgres://hardwareops:hardwareops@postgres:5432/hardwareops?sslmode=disable

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
S3_BUCKET=artifacts
S3_REGION=us-east-1
S3_ENDPOINT=minio:9000

CORS_ALLOWED_ORIGINS=https://hardwareops.internal
METRICS_ENABLED=1
METRICS_PATH=/metrics
METRICS_REFRESH_INTERVAL=30s

# Audit log retention
AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_CLEANUP_INTERVAL=1h

# Auth (v1 local users)
AUTH_MODE=disabled
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL=12h
AUTH_ISSUER=hardwareops
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=

# License enforcement (on-prem)
LICENSE_ENFORCE=1
LICENSE_PATH=/opt/hardwareops/license.json
LICENSE_PUBLIC_KEY=
LICENSE_PUBLIC_KEY_PATH=
LICENSE_KEY_MODE=env
LICENSE_CACHE_TTL=30s

# Certificate rotation (optional, but recommended)
CA_BUNDLE_PATH=/certs/ca-bundle.crt
ACTIVE_CA_CERT_PATH=/certs/ca-active.crt
ACTIVE_CA_KEY_PATH=/certs/ca-active.key
CERT_ROTATION_GRACE_PERIOD=168h

# Maintenance + upgrade
MAINTENANCE_MODE=0
MAINTENANCE_MESSAGE=
# Optional token required for UI toggle + upgrade apply
MAINTENANCE_TOKEN=change-me
# Optional upgrade runner (requires access to docker/host)
UPGRADE_APPLY_CMD=/app/scripts/apply-upgrade.sh
UPGRADE_WORK_DIR=/stack
UPGRADE_LOG_DIR=/var/lib/hardwareops/logs
UPGRADE_UPDATES_DIR=/stack/updates
# Optional: docker-based upgrade runner
UPGRADE_RUNNER_MODE=docker
# Optional: container image to run the upgrade (defaults to control-plane image)
UPGRADE_RUNNER_IMAGE=

# Backup + restore
BACKUP_CMD=/app/scripts/backup-stack.sh
RESTORE_CMD=/app/scripts/restore-stack.sh
BACKUP_DIR=/stack/backups
BACKUP_WORK_DIR=/stack
BACKUP_LOG_DIR=/var/lib/hardwareops/logs
BACKUP_RUNNER_MODE=docker
BACKUP_RUNNER_IMAGE=
# Optional explicit container names; defaults map to on-prem bundle names
BACKUP_POSTGRES_CONTAINER=
BACKUP_MINIO_CONTAINER=
BACKUP_POSTGRES_USER=hardwareops
BACKUP_POSTGRES_DB=hardwareops
