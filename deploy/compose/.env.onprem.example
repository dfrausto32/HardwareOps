DOMAIN=parcel.internal
PUBLIC_BASE_URL=https://parcel.internal
GATEWAY_TLS=1
CONTROL_PLANE_UPSTREAM=control-plane:8080
DNS_RESOLVER=127.0.0.11
AGENT_BASE_URL=https://agent.parcel.internal
CERTS_DIR=/opt/parcel/certs
STACK_DIR=/opt/parcel/stack

# Server TLS certificate strategy for gateway:
# - device-ca: auto-generate server.crt/server.key signed by device CA (dev/lab default)
# - external:  use provided server.crt/server.key (recommended for production browsers)
SERVER_CERT_MODE=device-ca
# Optional: source files copied into ${CERTS_DIR}/server.crt and ${CERTS_DIR}/server.key when SERVER_CERT_MODE=external
SERVER_CERT_INPUT=
SERVER_KEY_INPUT=

POSTGRES_USER=parcel
POSTGRES_PASSWORD=parcel
POSTGRES_DB=parcel
DATABASE_URL=postgres://parcel:parcel@postgres:5432/parcel?sslmode=disable

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
S3_BUCKET=artifacts
S3_REGION=us-east-1
S3_ENDPOINT=minio:9000

CORS_ALLOWED_ORIGINS=https://parcel.internal
TRUST_PROXY=1
# Replace with the exact reverse-proxy or gateway CIDRs before enabling HARDENED_PROFILE=1.
# Example: TRUST_PROXY_CIDRS=10.40.64.0/20,10.40.80.0/20
TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128
METRICS_ENABLED=1
METRICS_PATH=/metrics
METRICS_REFRESH_INTERVAL=30s

# Audit log retention
AUDIT_RETENTION_DAYS=90
AUDIT_RETENTION_CLEANUP_INTERVAL=1h
# Runtime event retention
EVENT_RETENTION_DAYS=30
EVENT_RETENTION_CLEANUP_INTERVAL=1h

# Artifact lifecycle (automatic prune + alerts)
ARTIFACT_PRUNE_ENABLED=1
ARTIFACT_PRUNE_INTERVAL=24h
ARTIFACT_PRUNE_BATCH_LIMIT=200
ARTIFACT_PRUNE_ALERT_REF_THRESHOLD=10
# Pull ingest safety controls
ARTIFACT_PULL_ALLOWED_HOSTS=
ARTIFACT_PULL_MAX_BYTES=1073741824
ARTIFACT_PULL_TIMEOUT=15m
ARTIFACT_PULL_ALLOW_INSECURE_HTTP=0
# Standard on-prem baseline. Set require_verified for stricter networks.
ARTIFACT_TRUST_VERIFICATION_MODE=warn_unsigned
ARTIFACT_TRUST_ALLOWED_SIGNING_KEY_IDS=
ARTIFACT_TRUST_ALLOWED_SIGNATURE_TYPES=
TRUSTED_SIGNING_KEYS_FILE=
TRUSTED_SIGNING_KEYS_JSON=
TRUSTED_SIGNING_KEYS_AWS_SECRET_ID=
TRUSTED_SIGNING_KEYS_AWS_REGION=
ARTIFACT_SIGNATURE_REQUIRE_DEFAULT=0
ARTIFACT_SIGNATURE_ENFORCE_INGEST=0
ARTIFACT_SIGNATURE_KEY_ID=
ARTIFACT_PULL_CREDENTIALS_FILE=
ARTIFACT_PULL_CREDENTIALS_JSON=
ARTIFACT_PULL_CREDENTIALS_AWS_SECRET_ID=
ARTIFACT_PULL_CREDENTIALS_AWS_REGION=
# HashiCorp Vault KV v2 backend (mutually exclusive with AWS Secrets Manager)
ARTIFACT_PULL_CREDENTIALS_VAULT_ADDR=
ARTIFACT_PULL_CREDENTIALS_VAULT_TOKEN=
ARTIFACT_PULL_CREDENTIALS_VAULT_PATH=
# Supply-chain provenance / keyless cosign (leave blank to use public Sigstore roots)
ARTIFACT_FULCIO_ROOT_CERT=
ARTIFACT_REKOR_URL=
ARTIFACT_REQUIRE_REKOR_LOG=0
RELEASE_AUTO_UPDATE_INTERVAL=60s

# Auth (v1 local users)
AUTH_MODE=local
AUTH_JWT_SECRET=change-me
AUTH_TOKEN_TTL=12h
AUTH_LOGIN_RPM=30
AUTH_LOGIN_BACKOFF_ENABLED=1
AUTH_LOGIN_BACKOFF_THRESHOLD=3
AUTH_LOGIN_BACKOFF_BASE=2s
AUTH_LOGIN_BACKOFF_MAX=5m
AUTH_LOGIN_BACKOFF_WINDOW=15m
AUTH_ISSUER=parcel
AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=change-me
# Pending enrollment abuse controls (first-contact onboarding)
PENDING_ENROLL_REQUEST_RPM_PER_SOURCE=30
PENDING_ENROLL_REQUEST_RPM_PER_PROFILE=120
PENDING_ENROLL_MAX_ACTIVE=1000
PENDING_ENROLL_MAX_ACTIVE_PER_PROFILE=100
PENDING_ENROLL_MAX_ACTIVE_PER_SOURCE=10
AUTH_OIDC_ISSUER=
AUTH_OIDC_CLIENT_ID=
# LDAP / Active Directory (leave AUTH_LDAP_URL blank to disable)
AUTH_LDAP_URL=
AUTH_LDAP_BASE_DN=
AUTH_LDAP_BIND_DN=
AUTH_LDAP_BIND_PASSWORD=
# User search filter: (uid=%s) for OpenLDAP, (sAMAccountName=%s) for AD
AUTH_LDAP_USER_FILTER=
AUTH_LDAP_MAIL_ATTR=
AUTH_LDAP_DISPLAY_ATTR=
AUTH_LDAP_GROUP_ATTR=
# JSON map from group DN to role (admin|operator|viewer). Example:
# AUTH_LDAP_ROLE_MAP={"CN=HW-Admins,DC=corp,DC=example,DC=com":"admin"}
AUTH_LDAP_ROLE_MAP={}
AUTH_LDAP_DEFAULT_ROLE=viewer
# Optional CI workload identity provider config (JSON array or single object)
CI_WORKLOAD_IDENTITY_PROVIDERS_FILE=
CI_WORKLOAD_IDENTITY_PROVIDERS_JSON=
CI_WORKLOAD_IDENTITY_PROVIDERS_AWS_SECRET_ID=
CI_WORKLOAD_IDENTITY_PROVIDERS_AWS_REGION=
# Bootstrap onboarding token for unauthenticated CA download
BOOTSTRAP_TOKEN=change-me-bootstrap

# License enforcement (on-prem)
LICENSE_ENFORCE=1
LICENSE_PATH=/opt/parcel/license.json
LICENSE_PUBLIC_KEY=
LICENSE_PUBLIC_KEY_PATH=
LICENSE_KEY_MODE=env
LICENSE_CACHE_TTL=30s
# Hardened profile blocks insecure runtime combinations at startup.
HARDENED_PROFILE=0

# Device identity hardening (anti-clone / duplicate enrollment)
DEVICE_IDENTITY_MODE=audit
DEVICE_IDENTITY_REQUIRE_ON_ENROLL=0
DEVICE_IDENTITY_REQUIRE_ON_CHECKIN=0

# Certificate rotation (optional, but recommended)
CA_BUNDLE_PATH=/certs/ca-bundle.crt
ACTIVE_CA_CERT_PATH=/certs/ca-active.crt
ACTIVE_CA_KEY_PATH=/certs/ca-active.key
CERT_ROTATION_GRACE_PERIOD=168h

# Maintenance + upgrade
MAINTENANCE_MODE=0
MAINTENANCE_MESSAGE=
# Optional token for non-UI automation (for example apply-upgrade.sh auto-disable)
MAINTENANCE_TOKEN=change-me
# Upgrade runner is remote by default; maintenance-runner service holds docker socket privilege.
UPGRADE_APPLY_CMD=/app/scripts/apply-upgrade.sh
UPGRADE_WORK_DIR=/stack
UPGRADE_LOG_DIR=/var/lib/parcel/logs
UPGRADE_UPDATES_DIR=/stack/updates
UPGRADE_RUNNER_MODE=remote
UPGRADE_RUNNER_URL=http://maintenance-runner:8090
UPGRADE_RUNNER_TOKEN=change-me-maintenance-runner
# Optional: container image used by maintenance-runner when running docker-mode upgrade exec.
UPGRADE_RUNNER_IMAGE=

# Backup + restore
BACKUP_CMD=/app/scripts/backup-stack.sh
RESTORE_CMD=/app/scripts/restore-stack.sh
BACKUP_DIR=/stack/backups
BACKUP_WORK_DIR=/stack
BACKUP_LOG_DIR=/var/lib/parcel/logs
BACKUP_RUNNER_MODE=remote
BACKUP_RUNNER_URL=http://maintenance-runner:8090
BACKUP_RUNNER_TOKEN=change-me-maintenance-runner
BACKUP_RUNNER_IMAGE=
# Optional explicit container names; defaults map to on-prem bundle names
BACKUP_POSTGRES_CONTAINER=
BACKUP_MINIO_CONTAINER=
BACKUP_POSTGRES_USER=parcel
BACKUP_POSTGRES_DB=parcel

# Vulnerability scanning — artifact (Grype / Trivy)
# VULN_ARTIFACT_SCANNER=disabled
# VULN_ARTIFACT_SCANNER_BIN=grype
# VULN_ARTIFACT_SKIP_TYPES=

# Vulnerability scanning — device (Nessus / Tenable)
# VULN_NESSUS_URL=
# VULN_NESSUS_ACCESS_KEY=
# VULN_NESSUS_SECRET_KEY=
# VULN_NESSUS_SYNC_INTERVAL=1h
# VULN_NESSUS_SCAN_IDS=

# Email delivery (SMTP) — leave SMTP_HOST blank to disable
# APP_PUBLIC_URL=https://parcel.internal
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Parcel <noreply@example.com>
# SMTP_TLS_MODE=starttls
# SMTP_TIMEOUT=10s
# SMTP_SKIP_VERIFY=0
