# Postgres
POSTGRES_USER=hardwareops
POSTGRES_PASSWORD=hardwareops
POSTGRES_DB=hardwareops
POSTGRES_PORT=5432

# MinIO
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123
MINIO_CONSOLE_PORT=9001
MINIO_PORT=9000

# Caddy (reverse proxy)
CADDY_DOMAIN=example.com
CADDY_EMAIL=admin@example.com
# Optional: set to "internal" for local dev with Caddy's internal CA
CADDY_TLS=
# Path to device CA cert for client auth (default uses ../dev-ca.crt)
CADDY_CLIENT_CA_PATH=../dev-ca.crt
# Upstream control-plane host:port
CONTROL_PLANE_UPSTREAM=host.docker.internal:8080
