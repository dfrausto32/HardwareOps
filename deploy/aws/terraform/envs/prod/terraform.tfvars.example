aws_region    = "us-east-1"
customer_slug = "customer-a"
owner         = "platform"

vpc_cidr = "10.40.0.0/16"
public_subnet_cidrs = {
  "us-east-1a" = "10.40.0.0/20"
  "us-east-1b" = "10.40.16.0/20"
  "us-east-1c" = "10.40.32.0/20"
}
private_subnet_cidrs = {
  "us-east-1a" = "10.40.64.0/20"
  "us-east-1b" = "10.40.80.0/20"
  "us-east-1c" = "10.40.96.0/20"
}

route53_zone_id = "Z0123456789ABCDEFG"
app_host        = "app.customer-a.example.com"
devices_host    = "agent.customer-a.example.com"
# Optional split ingress controls. If unset, ingress_cidrs applies to both listeners.
# ingress_cidrs        = ["203.0.113.0/24"]
# app_ingress_cidrs    = ["203.0.113.0/24"]
# device_ingress_cidrs = ["0.0.0.0/0"]

acm_certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"

device_mtls_bucket = "customer-a-security-assets"
device_mtls_key    = "mtls/device-ca-bundle.pem"
# Start with "passthrough" during initial token-based enrollment, then switch to "verify".
device_mtls_mode   = "passthrough"
# WAF is enabled for app ingress by default. Uncomment to add a per-IP rate limit.
# waf_rate_limit    = 2000

control_plane_image = "111122223333.dkr.ecr.us-east-1.amazonaws.com/hardwareops-control-plane:latest"
gateway_image       = "111122223333.dkr.ecr.us-east-1.amazonaws.com/hardwareops-gateway:latest"
# Optional: Secrets Manager secret containing pull adapter credential map JSON.
# Example value (ARN recommended):
# artifact_pull_credentials_aws_secret_id = "arn:aws:secretsmanager:us-east-1:111122223333:secret:hardwareops/customer-a/prod/artifact-pull-credentials-AbCdEf"
# Optional: Secrets Manager secret containing trusted signing key bootstrap JSON.
# trusted_signing_keys_aws_secret_id = "arn:aws:secretsmanager:us-east-1:111122223333:secret:hardwareops/customer-a/prod/trusted-signing-keys-AbCdEf"
# Optional: Secrets Manager secret containing CI workload identity provider config JSON.
# ci_workload_identity_providers_aws_secret_id = "arn:aws:secretsmanager:us-east-1:111122223333:secret:hardwareops/customer-a/prod/workload-identity-providers-AbCdEf"
# If referenced Secrets Manager secrets use customer-managed CMKs, list those key ARNs.
# secret_kms_key_arns = ["arn:aws:kms:us-east-1:111122223333:key/00000000-0000-0000-0000-000000000000"]

db_instance_class            = "db.r6g.large"
db_multi_az                  = true
control_plane_desired_count  = 3
gateway_desired_count        = 3
# When using database_url_secret_arn (recommended for production), db_master_password
# is still used for RDS provisioning but won't appear in ECS task definitions.
db_manage_master_user_password = false
db_master_password             = "change-me-prod-password"

control_plane_env = {
  AUTH_MODE               = "local"
  AUTH_JWT_SECRET         = "replace-with-long-random-secret"
  AUTH_BOOTSTRAP_EMAIL    = "admin@customer-a.example.com"
  AUTH_BOOTSTRAP_PASSWORD = "replace-with-bootstrap-password"
  # Optional key pin when using strict artifact trust bootstrap.
  # ARTIFACT_TRUST_ALLOWED_SIGNING_KEY_IDS = "sha256:..."
  # ARTIFACT_SIGNATURE_KEY_ID              = "sha256:..."
  # Optional override; default is the private_subnet_cidrs values.
  # TRUST_PROXY_CIDRS       = "10.60.64.0/20,10.60.80.0/20,10.60.96.0/20"
}

gateway_env = {}

# Optional demo fleet (manual artifact switching in UI):
enable_demo_fleet = false
demo_agent_count  = 3
demo_agent_image  = null
demo_agent_cpu    = 256
demo_agent_memory = 512
demo_agent_checkin_interval_sec = 5
demo_bootstrap_email    = "admin@customer-a.example.com"
demo_bootstrap_password = "replace-with-bootstrap-password"

# Example for secret wiring:
# control_plane_secret_arns = {
#   DATABASE_URL = "arn:aws:secretsmanager:us-east-1:111122223333:secret:customer-a/dev/database-url"
#   MAINTENANCE_TOKEN = "arn:aws:secretsmanager:us-east-1:111122223333:secret:customer-a/dev/maintenance-token"
# }

# CloudWatch alarm routing
# alarm_sns_email = "ops-team@example.com"
# Tuning (optional — defaults are usually fine):
# alarm_alb_5xx_threshold             = 10
# alarm_ecs_cpu_threshold             = 80
# alarm_ecs_memory_threshold          = 80
# alarm_rds_cpu_threshold             = 80
# alarm_rds_free_storage_threshold_gb = 5
# alarm_rds_connections_threshold     = 100

# Recommended for production: store DATABASE_URL in Secrets Manager instead of plaintext.
# Create a secret with the full connection string:
#   aws secretsmanager create-secret --name "hardwareops/customer-a/prod/database-url" \
#     --secret-string "postgres://hardwareops:<password>@<rds-endpoint>:5432/hardwareops?sslmode=require"
# Then reference the ARN here:
# database_url_secret_arn = "arn:aws:secretsmanager:us-east-1:111122223333:secret:hardwareops/customer-a/prod/database-url-AbCdEf"
# Note: When db_manage_master_user_password = true, use the database_master_secret_arn output
# to locate the RDS-managed secret, but note it stores JSON (not a URL) — create a separate URL secret.

# ECS Exec — disabled by default for production security.
# Enable only for break-glass debugging sessions.
# enable_execute_command = true

# Optional SMTP/email delivery:
# app_public_url            = "https://app.customer-a.example.com"
# smtp_host                 = "smtp.example.com"
# smtp_port                 = 587
# smtp_user                 = "hardwareops"
# smtp_from                 = "HardwareOps <noreply@example.com>"
# smtp_tls_mode             = "starttls"
# smtp_timeout              = "10s"
# In production, store the SMTP password in Secrets Manager instead of plaintext.
# smtp_password_secret_arn  = "arn:aws:secretsmanager:us-east-1:111122223333:secret:hardwareops/customer-a/prod/smtp-password-AbCdEf"
