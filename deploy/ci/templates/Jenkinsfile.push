pipeline {
  agent any

  parameters {
    string(name: 'ARTIFACT_NAME', defaultValue: 'demo-artifact', description: 'Artifact name')
    string(name: 'ARTIFACT_VERSION', defaultValue: '0.1.0', description: 'Artifact version')
    string(name: 'ARTIFACT_TYPE', defaultValue: 'app_bundle', description: 'Artifact type')
    string(name: 'INPUT_DIR', defaultValue: './dist/artifact', description: 'Artifact input directory')
    text(name: 'METADATA_JSON', defaultValue: '{}', description: 'Metadata JSON')
  }

  environment {
    HWOPS_BASE_URL = credentials('hwops-base-url')
    // Optional workload identity settings. JENKINS_OIDC_TOKEN may be injected by an OIDC-capable plugin or wrapper.
    CI_WORKLOAD_IDENTITY_AUDIENCE = 'hardwareops-ci'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Publish Artifact') {
      steps {
        sh '''
          set -euo pipefail
          if [ -n "${HWOPS_CA_CERT_B64:-}" ]; then
            echo "$HWOPS_CA_CERT_B64" | base64 -d > /tmp/hwops-ca.crt
          fi

          if [ -n "${HWOPS_CI_SERVICE_TOKEN:-}" ]; then
            AUTH_TOKEN="$HWOPS_CI_SERVICE_TOKEN"
          elif [ -n "${JENKINS_OIDC_TOKEN:-}" ] || [ -n "${HWOPS_JENKINS_ID_TOKEN:-}" ]; then
            AUTH_TOKEN="$(BASE_URL="$HWOPS_BASE_URL" CA_CERT_PATH=/tmp/hwops-ca.crt ./scripts/ci-exchange-jenkins-workload-identity.sh)"
          else
            echo "Either HWOPS_CI_SERVICE_TOKEN or JENKINS_OIDC_TOKEN/HWOPS_JENKINS_ID_TOKEN is required." >&2
            exit 1
          fi

          BASE_URL="$HWOPS_BASE_URL" \
          AUTH_TOKEN="$AUTH_TOKEN" \
          CA_CERT_PATH=/tmp/hwops-ca.crt \
          ARTIFACT_NAME="$ARTIFACT_NAME" \
          ARTIFACT_VERSION="$ARTIFACT_VERSION" \
          ARTIFACT_TYPE="$ARTIFACT_TYPE" \
          INPUT_DIR="$INPUT_DIR" \
          METADATA_JSON="$METADATA_JSON" \
          ./scripts/ci-upload-artifact.sh
        '''
      }
    }
  }
}
